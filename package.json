{
  "name": "super-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"pnpm --filter @super-system/api dev\" \"pnpm --filter @super-system/web dev\"",
    "dev:desktop": "pnpm --filter @super-system/desktop dev",
    "build": "pnpm --filter @super-system/web build && pnpm --filter @super-system/api build && pnpm --filter @super-system/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @super-system/api start",
    "desktop": "pnpm --filter @super-system/desktop start"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
