# Explicit provider selection: legacy (REST) or app-server (current Letta SDK).
LETTA_MODE=legacy
# Your existing Letta endpoint. Leave blank until configured; no demo data is used.
LETTA_BASE_URL=
LETTA_API_KEY=
LETTA_AGENT_ID=
LETTA_SERVER_TOKEN=

# Local development binds only to loopback. Hosted use requires APP_PASSWORD.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
APP_PASSWORD=
SESSION_SECRET=
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
# Optional PostgreSQL. Without it, local single-process state uses .data/state.json.
DATABASE_URL=
# Electron uses the same web application. For hosted use set your HTTPS URL.
SUPER_SYSTEM_URL=http://127.0.0.1:5173
